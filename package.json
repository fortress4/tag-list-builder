{
  "name": "tag-list-builder",
  "version": "0.3.0",
  "private": true,
  "description": "A Bootstrap tag-list builder with JSON storage, optional sorting, and optional typeahead support.",
  "main": "dist/js/tag-builder.js",
  "style": "dist/css/tag-builder.css",
  "peerDependencies": {
    "jquery": ">=4.0.0 <5.0.0",
    "bootstrap": ">=5.3.8 <6.0.0",
    "bootbox": ">=6.0.4 <7.0.0",
    "html5sortable": ">=0.14.0 <0.15.0",
    "jquery-typeahead": ">=2.11.1 <3.0.0"
  },
  "peerDependenciesMeta": {
    "bootbox": {
      "optional": true
    },
    "html5sortable": {
      "optional": true
    },
    "jquery-typeahead": {
      "optional": true
    }
  },
  "files": [
    "dist/",
    "css/",
    "js/",
    "README.md",
    "version.json"
  ],
  "scripts": {
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build.ps1",
    "check": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build.ps1 -Check"
  },
  "keywords": [
    "bootstrap",
    "jquery",
    "tag-builder",
    "tags",
    "typeahead"
  ]
}
